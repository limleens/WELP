# Copy to .env and edit; do NOT commit actual keys.
# Obtain an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current Gemini text model; override if this model isn't available to your project.
GEMINI_MODEL=gemini-3.8-flash
# Optional expressive cloud TTS; 0 means use browser voice (lower latency).
GEMINI_TTS=0
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
PORT=8000
